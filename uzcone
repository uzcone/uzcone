  <!-- ================= JAVASCRIPT ================= -->
  <script>
    // 1. Mobile Menu Toggle
    function toggleMenu() {
      const menu = document.getElementById('mobileMenu');
      menu.classList.toggle('hidden');
    }
    document.getElementById('mobileMenuBtn').addEventListener('click', toggleMenu);

    // 2. Project Category Filtering
    function applyFilter(category) {
      const cards = document.querySelectorAll('.project-card');
      const buttons = document.querySelectorAll('.filter-tab');

      buttons.forEach(btn => {
        if (btn.getAttribute('data-filter') === category) {
          btn.className = "filter-tab active px-3.5 py-1.5 rounded-lg bg-slate-900 text-white";
        } else {
          btn.className = "filter-tab px-3.5 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-50";
        }
      });

      cards.forEach(card => {
        const itemCategory = card.getAttribute('data-category');
        if (category === 'all' || itemCategory === category) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // 3. Modal Open/Close Controls
    function openTohirMapModal() {
      const modal = document.getElementById('tohirMapModal');
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeTohirMapModal() {
      const modal = document.getElementById('tohirMapModal');
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }

    // Close modal on backdrop click
    document.getElementById('tohirMapModal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeTohirMapModal();
      }
    });

    // Close modal with ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeTohirMapModal();
      }
    });

    // 4. Safe Clipboard Copy function
    function copyToClipboard(text, successMessage) {
      const tempInput = document.createElement("input");
      tempInput.style.position = "absolute";
      tempInput.style.left = "-9999px";
      tempInput.value = text;
      document.body.appendChild(tempInput);
      tempInput.select();
      
      try {
        document.execCommand("copy");
        showToast(successMessage);
      } catch (err) {
        console.error("복사 실패:", err);
      } finally {
        document.body.removeChild(tempInput);
      }
    }

    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      toastMsg.textContent = message;
      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
      
      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 2500);
    }
  </script>
